# Copy to demo.env (mode 600). Never add model, Google Ads, voice or email
# keys to this file: without them the demo can't spend money.
FRONTEND_ORIGIN=https://pitcrew-public.my.id
# PITSTOP_DB_STRING uses the password in db_password.txt.
PITSTOP_DB_STRING=postgresql://pitstop:<db password>@db:5432/pitstop
# Owner login: a fresh random password, kept by Arthur.
AUTH_USERNAME=owner
AUTH_PASSWORD=
# Read-only demo login, given to reviewers on request.
DEMO_USERNAME=demo
DEMO_PASSWORD=
