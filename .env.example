# Postgres, hosted on Sumopod/Sumobase (PgBouncer on port 6432 — see db.py)
PITSTOP_DB_STRING=postgresql://user:password@host:6432/dbname

# Google Ads API credentials (see PROJECT.md → Auth / API Setup Progress)
gads-api-token=
client-id=
client-secret=
gads-refresh-token=
gads-login-customer-id=
gads-target-customer-id=

# AI layer — routed through Sumopod (OpenAI-compatible gateway). Any
# OpenAI-compatible endpoint works with no code change: to call OpenAI
# directly, set SUMOPOD_BASE_URL=https://api.openai.com/v1 and put an OpenAI
# key in sumopod-api-key. The model names (gpt-5-mini, gpt-5.4) are OpenAI's.
sumopod-api-key=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# Optional: USD per 1M tokens, per model name, used to fill pipeline_runs.cost_usd_micros.
# Left unset, token counts are still recorded but cost stays null (no guessed rates).
# Use your gateway's real rates; a model with no entry stays unpriced (null), never $0. Shape:
# LLM_PRICES_JSON={"<model-name>":{"input":<USD per 1M>,"cached_input":<USD per 1M, optional>,"output":<USD per 1M>}}
LLM_PRICES_JSON=

# Email delivery — Resend primary, Gmail SMTP fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=reports@example.com
REPORT_RECIPIENT_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# "demo" or "live"
DATA_SOURCE=demo

# Frontend origin, for CORS (real Vercel URL once deployed)
FRONTEND_ORIGIN=http://localhost:5173

# API login. AUTH_* is the full-access owner account (required). DEMO_* is an
# optional read-only account for a public demo link — the demo login does not
# exist unless both are set. Sessions last 24 hours. (see backend/src/platform/auth.ts)
AUTH_USERNAME=
AUTH_PASSWORD=
DEMO_USERNAME=
DEMO_PASSWORD=

# ElevenLabs — text-to-speech, for the planned voice assistant (see VOICE_ASSISTANT.md)
ELEVENLABS_API_KEY=

# Used-car inventory source for the planned keyword optimizer (read-only). Postgres connection
# string; leave empty to use the demo vehicles table. Not wired up yet.
INVENTORY_DB_STRING=
